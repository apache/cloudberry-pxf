-- @description query01 for PXF parallel scan EXPLAIN - Parallel Foreign Scan under a gang-parallel Gather Motion when parallel enabled
-- start_matchsubs
--
-- m/Gather Motion \d+:1  \(slice\d+; segments: \d+\)/
-- s/Gather Motion \d+:1  \(slice\d+; segments: \d+\)/Gather Motion N:1  (sliceN; segments: N)/
--
-- m/actual rows=\d+ loops=\d+/
-- s/actual rows=\d+ loops=\d+/actual rows=N loops=N/
--
-- end_matchsubs
SET optimizer = off;
SET
SET enable_parallel = true;
SET
SET max_parallel_workers_per_gather = 4;
SET
EXPLAIN (COSTS OFF) SELECT count(*) FROM pxf_parallel_enabled;
                           QUERY PLAN
-----------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 12:1  (slice1; segments: 12)
         ->  Partial Aggregate
               ->  Parallel Foreign Scan on pxf_parallel_enabled
 Optimizer: Postgres query optimizer
(5 rows)
